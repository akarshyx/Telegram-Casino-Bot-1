# Copy only the variables needed for the features you enable into the VPS
# environment. Do not commit real values here.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID that owns the casino. This is used for owner
# callbacks and the exploit review command.
OWNER_ID=
# If the original secret cannot be edited, use this override instead.
TELEGRAM_BOT_TOKEN_V2=

# Optional: needed only for the separate dealer-bot game flows.
DEALER_BOT_TOKEN=

# Optional payment configuration used by deposit/withdrawal features.
NOWPAYMENTS_API_KEY=
# Deposit addresses/QR codes come from NOWPayments. Deposit settlement is
# performed by the independent blockchain monitor, not by NOWPayments IPN.
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
TOTP_SECRET=

# Optional payout/provider configuration.
PLISIO_SECRET_KEY=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=
CRYPTOMUS_PAYOUT_API_KEY=
USE_SANDBOX=false

# Optional group configuration. Set the real IDs if group announcements or
# surprise drops are enabled.
CASINO_GROUP_ID=
GROUP_CHAT_ID=

# Required when NOWPayments IPN deposits are enabled. Use the public HTTPS
# URL without a trailing slash.
SERVER_URL=

# Optional web-server configuration.
PORT=5000
SESSION_SECRET=
FLASK_SECRET_KEY=